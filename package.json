{
  "name": "workdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/domain",
    "packages/db",
    "packages/api"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx packages/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build -w @workdeck/web",
    "typecheck": "npm run typecheck:backend && npm run typecheck:web",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx packages/db/src/cli.ts",
    "db:seed": "tsx packages/db/src/cli.ts --seed"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.28"
  }
}
